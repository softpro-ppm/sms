APP_NAME="Student Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_password

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
# Use database (or redis) in production so transactional mail queues; run: php artisan queue:work
QUEUE_CONNECTION=database
# After payment approval, AMS sync runs via SyncPaymentToAmsJob — workers must process this queue in production.

MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=your_email@domain.com
MAIL_PASSWORD=your_mail_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@softpro.co.in
MAIL_FROM_NAME="Softpro Skill Solutions"

# Partner registration OTP emails are sent from info@softpro.co.in (configured in PartnerRegistrationOtpMail)
# Logo upload norms
LOGO_MAX_SIZE_KB=512

# AMS (Account Management System) integration - sync fee income
AMS_API_URL=https://ams.softpromis.com/api/income/from-sms
AMS_API_KEY=

# WhatsApp Business API
WHATSAPP_ACCESS_TOKEN=your_meta_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_API_URL=https://graph.facebook.com/v17.0
WHATSAPP_BUTTON_URL_EMPTY_SUFFIX=true

# WhatsApp webhook (Meta → POST /webhook/whatsapp) and inbox fallback centre
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta App Secret (same app as access token). Required in production: validates X-Hub-Signature-256 on POST. Leave empty only for local/dev without Meta posting.
WHATSAPP_APP_SECRET=
# If set, inbound chats that do not match a student still appear for this training_partner_id
WHATSAPP_INBOX_DEFAULT_TRAINING_PARTNER_ID=
# Free-text inbox replies only within N hours of customer’s last message (Meta: customer care window)
WHATSAPP_INBOX_FREEFORM_REPLY_HOURS=24

# Super Admin dashboard: flag Standard partners below this wallet balance
SMS_LOW_WALLET_THRESHOLD=500

# Public verification POST (/verify, legacy /public/student-verification/search) throttle — requests per minute per IP (default 20).
VERIFY_SEARCH_RATE_LIMIT_PER_MINUTE=20

# Student PWA push notifications (generate VAPID keys before enabling browser push)
WEBPUSH_VAPID_SUBJECT=mailto:admin@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=

# Scheduled backup (sms:backup-scheduled daily 03:00 via cron schedule:run)
# Optional: Laravel disk name to upload SQL (and optional zip) after local dump, e.g. s3
BACKUP_REMOTE_DISK=
# Also zip storage/app/public and upload when remote disk is set (large)
BACKUP_INCLUDE_PUBLIC_STORAGE=false
